{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codassol-witness-v03",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "vars": {
    "CODASSOL_PUBLIC_DOMAIN": "https://replace-with-your-fixed-domain.example"
  },
  "durable_objects": {
    "bindings": [
      { "name": "WITNESS", "class_name": "CodasSolWitness" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodasSolWitness"]
    }
  ]
}
